NODE_ENV=development
PORT=7171
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=dixapi
JWT_AUDIENCE=dixapi-api
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_URL=https://dixapi-backend-production.up.railway.app
LOG_LEVEL=info

# EvolutionAPI (WhatsApp gateway)
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_API_GLOBAL_KEY=replace-with-evolution-global-key
EVOLUTION_WEBHOOK_SECRET=replace-with-a-secret-for-webhook-signature
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_MANAGER_PASSWORD=Manager@12345
DEFAULT_OPERATOR_PASSWORD=Operator@12345
