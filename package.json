{
  "name": "ecms6-diixwhatsapp-backend",
  "version": "1.0.0",
  "description": "Backend profissional ECMS6 / DiixWhatsApp - API REST Node.js para dashboard DiixWhatsApp",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"tests/api.integration.test.js\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/typecheck.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "api",
    "rest",
    "nodejs",
    "express",
    "prisma",
    "postgresql",
    "multi-tenant",
    "whatsapp",
    "crm",
    "ecommerce"
  ],
  "author": "DiixWhatsApp Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.2",
    "pino-http": "^9.0.0",
    "prisma": "^5.7.0",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "supertest": "^6.3.3",
    "vitest": "^4.1.11"
  }
}