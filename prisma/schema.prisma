  company     Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, event_type, created_at])
  @@index([entity_type, entity_id])
  @@map("notification_events")
}

model CustomerConsent {
  id              String        @id @default(uuid()) @db.Uuid
  company_id      String        @db.Uuid
  customer_id     String        @db.Uuid
  status          ConsentStatus
  source          String
  purpose         String
  occurred_at     DateTime      @default(now())
  retention_until DateTime?
  evidence_ref    String?
  company         Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [company_id, customer_id], references: [company_id, id], onDelete: Cascade)

  @@index([company_id, customer_id, occurred_at])
  @@map("customer_consents")
}

model PaymentEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  company_id         String             @db.Uuid
  payment_id         String             @db.Uuid
  provider           String
  provider_event_id  String
  event_type         String
  status             PaymentEventStatus @default(received)
  signature_valid    Boolean            @default(false)
  provider_timestamp DateTime?
  payload_hash       String
  processed_at       DateTime?
  failure_reason     String?
  created_at         DateTime           @default(now())
  company            Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, provider, provider_event_id])
  @@index([company_id, payment_id, created_at])
  @@map("payment_events")
}

model DriverPayout {
  id           String             @id @default(uuid()) @db.Uuid
  company_id   String             @db.Uuid
  driver_id    String             @db.Uuid
  delivery_id  String?            @db.Uuid
  amount       Decimal            @db.Decimal(12, 2)
  status       DriverPayoutStatus @default(pending)
  period_start DateTime
  period_end   DateTime
  approved_at  DateTime?
  paid_at      DateTime?
  created_by   String?            @db.Uuid
  created_at   DateTime           @default(now())
  company      Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  driver       Driver             @relation(fields: [driver_id], references: [id], onDelete: Restrict)

  @@index([company_id, driver_id, status, period_end])
  @@map("driver_payouts")
}
