generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  master
  reseller
  admin
  manager
  operator
  visitor
}

enum UserStatus {
  pending
  active
  inactive
  suspended
}

enum CompanyType {
  store
  demo
  internal
}

enum CompanyStatus {
  pending
  active
  suspended
  cancelled
}

enum AccountRole {
  owner
  admin
  manager
  operator
  driver
  viewer
  visitor
}

enum PlanCode {
  simple
  silver
  diamond
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum FeatureValueType {
  boolean
  integer
  decimal
  text
  json
}

enum PlatformTransactionType {
  subscription
  setup_fee
  refund
  adjustment
  commission
}

enum PlatformTransactionStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum CommissionStatus {
  pending
  approved
  paid
  cancelled
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
  cancelled
}

enum AuditAction {
  create
  update
  delete
  login
  logout
  activate
  suspend
  cancel
  payment
  refund
}

enum CustomerSegment {
  vip
  frequent
  occasional
  new
}

enum CustomerStatus {
  active
  inactive
}

enum ProductStatus {
  active
  inactive
  low_stock
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  boleto
  whatsapp_pay
  cash_on_delivery
  card_on_delivery
}

enum ConversationChannel {
  whatsapp
  instagram
  facebook
  site
}

enum ConversationStatus {
  open
  closed
  waiting
}

enum MessageSenderType {
  user
  customer
  bot
}

enum MessageType {
  text
  image
  file
  audio
}

enum MessageStatus {
  sent
  delivered
  read
}

enum AutomationFlowType {
  vendas
  suporte
  marketing
}

enum TransactionType {
  income
  expense
}

enum TransactionStatus {
  pending
  completed
}

enum NotificationType {
  order
  message
  payment
  stock
  automation
}

enum DeliveryMode {
  delivery
  pickup
}

enum DeliveryStatus {
  pending
  confirmed
  preparing
  ready_for_pickup
  assigned
  picked_up
  in_transit
  at_location
  delivered
  cancelled
  failed
}

enum DeliveryProviderType {
  own
  partner
  marketplace
}

enum DriverStatus {
  available
  unavailable
  inactive
}

enum PaymentRecordStatus {
  pending
  authorized
  paid
  failed
  cancelled
  refunded
}

enum PaymentChannel {
  online
  whatsapp_manual
  whatsapp_api
  delivery_cash
  delivery_card
  delivery_pix
}

enum AffiliateSaleStatus {
  pending
  approved
  cancelled
  paid
}

enum CashRegisterStatus {
  open
  closed
  reconciled
}

enum CashMovementType {
  opening
  sale
  expense
  withdrawal
  deposit
  refund
  adjustment
  closing
}

enum WhatsAppNumberStatus {
  pending
  connected
  disconnected
  suspended
}

enum WhatsAppMessageDirection {
  inbound
  outbound
}

enum VehicleType {
  car
  motorcycle
  bicycle
  van
  other
}

enum CatalogKind {
  store_category
  service_category
}

enum PromotionType {
  percentage
  fixed_amount
  free_shipping
  buy_x_get_y
}

enum PromotionStatus {
  draft
  scheduled
  active
  paused
  expired
  cancelled
}

enum CouponDiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum CouponStatus {
  active
  paused
  expired
  exhausted
}

enum CommunicationAudience {
  store
  employees
  customers
  drivers
  resellers
  administrators
}

enum CommunicationChannel {
  in_app
  email
  whatsapp
  sms
}

enum CommunicationStatus {
  draft
  scheduled
  sending
  sent
  failed
  cancelled
}

enum MessagePriority {
  low
  normal
  high
  critical
}

enum ConsentStatus {
  unknown
  opted_in
  opted_out
}

enum PaymentEventStatus {
  received
  processed
  ignored
  failed
}

enum DriverPayoutStatus {
  pending
  approved
  paid
  cancelled
}

enum CommunicationTargetStatus {
  pending
  queued
  sending
  delivered
  failed
  cancelled
}

enum ForwardRuleMode {
  fixed
  operator
  group
  round_robin
}

enum MessageLogDirection {
  inbound
  outbound
  forward
}

enum MessageLogEvent {
  group_forward
  media_forward
  flow_action
  alert
  unknown
}

enum NotificationTriggerChannel {
  app
  whatsapp
  both
}

// Models
model Company {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  trade_name         String?
  cnpj               String?       @unique
  address_street     String?
  address_number     String?
  address_complement String?
  address_city       String?
  address_state      String?
  address_zip        String?
  website            String?
  description        String?
  logo_url           String?
  is_active          Boolean       @default(true)
  legal_name         String?
  state_registration String?
  support_email      String?
  support_phone      String?
  whatsapp_enabled   Boolean       @default(false)
  ecommerce_enabled  Boolean       @default(true)
  default_currency   String        @default("BRL")
  company_type       CompanyType   @default(store)
  status             CompanyStatus @default(pending)
  reseller_id        String?       @db.Uuid
  created_by         String?       @db.Uuid
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  customers               Customer[]
  products                Product[]
  orders                  Order[]
  conversations           Conversation[]
  automation_flows        AutomationFlow[]
  transactions            Transaction[]
  quick_replies           QuickReply[]
  notifications           Notification[]
  memberships             UserCompany[]
  reseller                Reseller?              @relation("ResellerCompanies", fields: [reseller_id], references: [id], onDelete: SetNull)
  subscription            CompanySubscription?
  platform_transactions   PlatformTransaction[]
  commissions             Commission[]
  status_history          CompanyStatusHistory[]
  audit_logs              AuditLog[]
  delivery_settings       DeliverySettings?
  delivery_zones          DeliveryZone[]
  delivery_drivers        DeliveryDriver[]
  deliveries              Delivery[]
  payments                PaymentRecord[]
  whatsapp_numbers        WhatsAppNumber[]
  whatsapp_contacts       WhatsAppContact[]
  consent_history         CustomerConsent[]
  whatsapp_messages       WhatsAppMessage[]
  cash_registers          CashRegister[]
  affiliate_sales         AffiliateSale[]
  driver_links            DriverCompany[]
  CashMovement            CashMovement[]
  category_links          CompanyCategory[]
  service_links           CompanyService[]
  customization           CompanyCustomization?
  promotions              Promotion[]
  coupons                 Coupon[]
  communications          Communication[]
  communication_targets   CommunicationTarget[]
  notification_events     NotificationEvent[]
  payment_events          PaymentEvent[]
  driver_payouts          DriverPayout[]
  order_notification_logs OrderNotificationLog[]
  NotificationTrigger     NotificationTrigger[]
  WhatsAppLinkedGroup     WhatsAppLinkedGroup[]
  MessageLog              MessageLog[]

  @@index([cnpj])
  @@index([is_active])
  @@map("companies")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  phone         String?
  avatar_url    String?
  password_hash String
  role          UserRole  @default(operator)
  language      String    @default("pt-BR")
  timezone      String    @default("America/Sao_Paulo")
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  conversations  Conversation[] @relation("AssignedConversations")
  notifications  Notification[]
  refresh_tokens RefreshToken[]
  quick_replies  QuickReply[]   @relation("QuickReplyCreatedBy")
  UserCompany    UserCompany[]
  Reseller       Reseller?

  @@index([email])
  @@index([role])
  @@index([is_active])
  @@map("users")
}

model Customer {
  id                 String          @id @default(uuid()) @db.Uuid
  company_id         String          @db.Uuid
  name               String
  email              String?
  phone              String
  segment            CustomerSegment @default(new)
  status             CustomerStatus  @default(active)
  total_orders       Int             @default(0)
  total_spent        Decimal         @default(0) @db.Decimal(10, 2)
  last_purchase_date DateTime?       @db.Date
  registered_at      DateTime        @default(now()) @db.Date
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  company         Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  orders          Order[]
  conversations   Conversation[]
  consent_history CustomerConsent[]

  @@unique([company_id, id])
  @@index([company_id])
  @@index([company_id, segment, status])
  @@index([company_id, status])
  @@index([company_id, email, phone])
  @@index([segment])
  @@index([status])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  company_id    String        @db.Uuid
  name          String
  description   String?
  category      String
  price         Decimal       @db.Decimal(10, 2)
  cost          Decimal       @default(0) @db.Decimal(10, 2)
  stock         Int           @default(0)
  min_stock     Int           @default(5)
  total_sales   Int           @default(0)
  total_revenue Decimal       @default(0) @db.Decimal(10, 2)
  status        ProductStatus @default(active)
  image_url     String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  company     Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  order_items OrderItem[]

  @@index([company_id])
  @@index([category])
  @@index([status])
  @@index([company_id, category, status])
  @@map("products")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  order_number     String
  company_id       String        @db.Uuid
  customer_id      String        @db.Uuid
  status           OrderStatus   @default(pending)
  payment_method   PaymentMethod
  subtotal         Decimal       @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  shipping_cost    Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  shipping_address String?
  notes            String?
  order_date       DateTime      @default(now())
  completed_at     DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  company         Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [company_id, customer_id], references: [company_id, id], onDelete: Restrict)
  order_items     OrderItem[]
  transactions    Transaction[]
  delivery        Delivery?
  payments        PaymentRecord[]
  affiliate_sales AffiliateSale[]

  @@unique([company_id, id])
  @@unique([company_id, order_number])
  @@index([company_id, customer_id])
  @@index([company_id, status, order_date])
  @@index([company_id, order_date])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  order_id   String   @db.Uuid
  product_id String   @db.Uuid
  quantity   Int
  unit_price Decimal  @db.Decimal(10, 2)
  unit_cost  Decimal? @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model Conversation {
  id              String              @id @default(uuid()) @db.Uuid
  company_id      String              @db.Uuid
  customer_id     String?             @db.Uuid
  channel         ConversationChannel
  contact_name    String
  contact_phone   String?
  last_message    String?
  last_message_at DateTime?
  unread_count    Int                 @default(0)
  is_pinned       Boolean             @default(false)
  is_archived     Boolean             @default(false)
  assigned_to     String?             @db.Uuid
  status          ConversationStatus  @default(open)
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  company  Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [company_id, customer_id], references: [company_id, id], onDelete: Restrict)
  assignee User?     @relation("AssignedConversations", fields: [assigned_to], references: [id], onDelete: Restrict)
  messages Message[]

  @@unique([company_id, id])
  @@index([company_id])
  @@index([company_id, channel])
  @@index([company_id, status])
  @@index([company_id, status, updated_at])
  @@index([channel])
  @@index([status])
  @@index([assigned_to])
  @@index([customer_id])
  @@map("conversations")
}

model Message {
  id              String            @id @default(uuid()) @db.Uuid
  conversation_id String            @db.Uuid
  sender_type     MessageSenderType
  sender_id       String?           @db.Uuid
  message_type    MessageType       @default(text)
  content         String
  media_url       String?
  status          MessageStatus     @default(sent)
  is_read         Boolean           @default(false)
  read_at         DateTime?
  sent_at         DateTime          @default(now())
  created_at      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([conversation_id, created_at])
  @@index([sender_type])
  @@index([created_at])
  @@map("messages")
}

model AutomationFlow {
  id                String             @id @default(uuid()) @db.Uuid
  company_id        String             @db.Uuid
  name              String
  type              AutomationFlowType
  description       String?
  icon_emoji        String?
  messages_count    Int                @default(0)
  total_conversions Int                @default(0)
  conversion_rate   Decimal            @default(0) @db.Decimal(5, 2)
  growth_percentage Decimal            @default(0) @db.Decimal(5, 2)
  is_active         Boolean            @default(true)
  config_json       Json?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([type])
  @@index([is_active])
  @@map("automation_flows")
}

model Transaction {
  id               String            @id @default(uuid()) @db.Uuid
  company_id       String            @db.Uuid
  order_id         String?           @db.Uuid
  description      String
  type             TransactionType
  category         String
  value            Decimal           @db.Decimal(12, 2)
  status           TransactionStatus @default(pending)
  payment_method   PaymentMethod?
  transaction_date DateTime          @db.Date
  due_date         DateTime?         @db.Date
  paid_at          DateTime?
  notes            String?
  attachment_url   String?
  idempotency_key  String?
  created_by       String?           @db.Uuid
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([order_id])
  @@index([type])
  @@index([status])
  @@index([transaction_date])
  @@map("transactions")
}

model QuickReply {
  id           String   @id @default(uuid()) @db.Uuid
  company_id   String   @db.Uuid
  shortcut     String
  message_text String
  created_by   String?  @db.Uuid
  usage_count  Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator User?   @relation("QuickReplyCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)

  @@unique([company_id, shortcut])
  @@index([company_id])
  @@index([shortcut])
  @@map("quick_replies")
}

model Notification {
  id                  String           @id @default(uuid()) @db.Uuid
  user_id             String           @db.Uuid
  company_id          String           @db.Uuid
  type                NotificationType
  title               String
  message             String
  is_read             Boolean          @default(false)
  related_entity_type String?
  related_entity_id   String?          @db.Uuid
  created_at          DateTime         @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, id])
  @@index([user_id])
  @@index([company_id])
  @@index([is_read])
  @@index([type])
  @@map("notifications")
}

model OrderNotificationLog {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  order_id        String?  @db.Uuid
  delivery_id     String?  @db.Uuid
  event           String
  recipient       String
  recipient_phone String
  message         String
  status          String   @default("sent")
  error           String?
  created_at      DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, id])
  @@index([company_id, created_at])
  @@index([company_id, event])
  @@map("order_notification_logs")
}

model NotificationTrigger {
  id             String                     @id @default(uuid()) @db.Uuid
  company_id     String                     @db.Uuid
  event          String
  channel        NotificationTriggerChannel @default(app)
  recipient_rule Json?
  template       String?
  is_active      Boolean                    @default(true)
  created_by     String?                    @db.Uuid
  created_at     DateTime                   @default(now())
  updated_at     DateTime                   @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, event, channel])
  @@index([company_id, is_active])
  @@map("notification_triggers")
}

model UserCompany {
  id          String      @id @default(uuid()) @db.Uuid
  user_id     String      @db.Uuid
  company_id  String      @db.Uuid
  role        AccountRole @default(operator)
  permissions Json?
  is_primary  Boolean     @default(false)
  status      UserStatus  @default(active)
  invited_by  String?     @db.Uuid
  joined_at   DateTime?
  removed_at  DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id])
  @@index([company_id, role, status])
  @@map("user_companies")
}

model Reseller {
  id                  String                 @id @default(uuid()) @db.Uuid
  user_id             String                 @unique @db.Uuid
  name                String
  legal_name          String?
  document            String?
  email               String
  phone               String?
  commission_type     String                 @default("percentage")
  commission_value    Decimal                @default(0) @db.Decimal(10, 2)
  status              UserStatus             @default(active)
  created_by          String?                @db.Uuid
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  user                User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  companies           Company[]              @relation("ResellerCompanies")
  commissions         Commission[]
  PlatformTransaction PlatformTransaction[]
  Payout              Payout[]
  affiliate_codes     AffiliateCode[]
  affiliate_sales     AffiliateSale[]
  reseller_cash       ResellerCashMovement[]

  @@index([status])
  @@map("resellers")
}

model Plan {
  id               String                @id @default(uuid()) @db.Uuid
  code             PlanCode              @unique
  name             String
  description      String?
  monthly_price    Decimal               @db.Decimal(12, 2)
  yearly_price     Decimal               @db.Decimal(12, 2)
  trial_days       Int                   @default(0)
  max_users        Int?
  max_products     Int?
  max_orders_month Int?
  max_drivers      Int?
  is_active        Boolean               @default(true)
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  features         PlanFeature[]
  subscriptions    CompanySubscription[]

  @@map("plans")
}

model PlanFeature {
  id            String           @id @default(uuid()) @db.Uuid
  plan_id       String           @db.Uuid
  key           String
  name          String
  description   String?
  value_type    FeatureValueType
  boolean_value Boolean?
  integer_value Int?
  decimal_value Decimal?         @db.Decimal(12, 2)
  text_value    String?
  json_value    Json?
  plan          Plan             @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, key])
  @@map("plan_features")
}

model CompanySubscription {
  id                       String                @id @default(uuid()) @db.Uuid
  company_id               String                @unique @db.Uuid
  plan_id                  String                @db.Uuid
  status                   SubscriptionStatus    @default(trialing)
  billing_cycle            BillingCycle          @default(monthly)
  price                    Decimal               @db.Decimal(12, 2)
  started_at               DateTime              @default(now())
  current_period_start     DateTime
  current_period_end       DateTime
  trial_ends_at            DateTime?
  grace_ends_at            DateTime?
  cancel_at_period_end     Boolean               @default(false)
  cancelled_at             DateTime?
  external_customer_id     String?
  external_subscription_id String?
  created_at               DateTime              @default(now())
  updated_at               DateTime              @updatedAt
  company                  Company               @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan                     Plan                  @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  events                   SubscriptionEvent[]
  PlatformTransaction      PlatformTransaction[]

  @@index([status, current_period_end])
  @@map("company_subscriptions")
}

model SubscriptionEvent {
  id               String              @id @default(uuid()) @db.Uuid
  subscription_id  String              @db.Uuid
  event_type       String
  previous_status  SubscriptionStatus?
  new_status       SubscriptionStatus?
  previous_plan_id String?             @db.Uuid
  new_plan_id      String?             @db.Uuid
  metadata         Json?
  created_by       String?             @db.Uuid
  created_at       DateTime            @default(now())
  subscription     CompanySubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id, created_at])
  @@map("subscription_events")
}

model PlatformTransaction {
  id                 String                    @id @default(uuid()) @db.Uuid
  company_id         String                    @db.Uuid
  reseller_id        String?                   @db.Uuid
  subscription_id    String?                   @db.Uuid
  type               PlatformTransactionType
  status             PlatformTransactionStatus @default(pending)
  amount             Decimal                   @db.Decimal(12, 2)
  currency           String                    @default("BRL")
  external_reference String?
  paid_at            DateTime?
  refunded_at        DateTime?
  notes              String?
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt
  company            Company                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  reseller           Reseller?                 @relation(fields: [reseller_id], references: [id], onDelete: SetNull)
  subscription       CompanySubscription?      @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  Commission         Commission[]

  @@index([company_id, status, created_at])
  @@index([reseller_id, status])
  @@map("platform_transactions")
}

model Commission {
  id                      String               @id @default(uuid()) @db.Uuid
  reseller_id             String               @db.Uuid
  company_id              String               @db.Uuid
  platform_transaction_id String?              @db.Uuid
  type                    String
  rate                    Decimal              @db.Decimal(7, 4)
